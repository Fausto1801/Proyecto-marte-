import numpy as np

def resolver_balance_masas():
    """
    Resuelve el sistema lineal para hallar la masa de propelente 
    en cada uno de los tres tanques de la primera etapa.
    """
    # Matriz de coeficientes A basada en las restricciones de los tanques
    A = np.array([
        [1,  1,  1],
        [1,  1, -1],
        [1, -2,  0]
    ])
    
    # Vector de términos independientes b (masas y diferencias requeridas)
    b = np.array([50000, 15000, 0])
    
    # Resolución del sistema lineal A * x = b utilizando numpy.linalg
    masas = np.linalg.solve(A, b)
    
    # Interpretación física en consola (requisito obligatorio)
    print(f"--- APARTADO 1: BALANCE DE MASAS ---")
    print(f"Masa del Tanque 1 (m1): {masas[0]:.2f} kg")
    print(f"Masa del Tanque 2 (m2): {masas[1]:.2f} kg")
    print(f"Masa del Tanque 3 (m3): {masas[2]:.2f} kg")
    print(f"Interpretación física: La suma total es {np.sum(masas):.2f} kg, lo que cumple exactamente con los 50000 kg iniciales requeridos por la misión y respeta los márgenes de estabilidad aerodinámica.\n")
    
    return masas

# Ejecutar la función de prueba
if __name__ == "__main__":
    m_tanques = resolver_balance_masas()
